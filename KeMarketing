    <!-- HAUPTINHALT -->
    <main>
        <h2>Was ist Marketing?</h2>
        <p>Marketing ist der Schlüssel zum Erfolg jeder Marke. Unsere Strategien helfen Unternehmen, ihre Reichweite zu maximieren und gezielt Kunden anzusprechen.</p>

        <h2>Unsere Marketing-Leistungen</h2>
        <ul>
            <li><strong>Social Media Management</strong> – Erstellen und Optimieren von Inhalten für Plattformen wie Instagram, Facebook & TikTok.</li>
            <li><strong>Content-Strategie</strong> – Entwicklung kreativer Kampagnen für Marken und Unternehmen.</li>
            <li><strong>Suchmaschinenoptimierung (SEO)</strong> – Verbesserung der Sichtbarkeit auf Google & Co.</li>
            <li><strong>Paid Advertising</strong> – Gezielte Werbekampagnen für maximale Reichweite.</li>
        </ul>

        <h2>Bewertung unserer Dienstleistungen</h2>
        <p>Teile uns dein Feedback mit, damit wir unsere Services weiter verbessern können:</p>

        <form>
            <fieldset>
                <legend>Personalien</legend>
                <label for="Vorname">Vorname</label>
                <input type="text" id="Vorname" name="Vorname" placeholder="Vorname eingeben" required>

                <label for="Nachname">Nachname</label>
                <input type="text" id="Nachname" name="Nachname" placeholder="Nachname eingeben" required>

                <label for="Geschlecht">Geschlecht</label>
                <select id="Geschlecht" name="Geschlecht" required>
                    <option value="">Geschlecht wählen</option>
                    <option value="weiblich">Weiblich</option>
                    <option value="männlich">Männlich</option>
                    <option value="anderes">Anderes</option>
                </select>

                <label for="Email">E-Mail</label>
                <input type="email" id="Email" name="Email" placeholder="E-Mail eingeben" required>
            </fieldset>

            <fieldset>
                <legend>Bewertung</legend>
                <label for="Arbeitnehmender">Arbeitnehmende</label>
                <input list="Arbeitnehmende" id="Arbeitnehmender" name="Arbeitnehmender" placeholder="Person auswählen" required>
                <datalist id="Arbeitnehmende">
                    <option value="John Smith">Verkauf</option>
                    <option value="Ella Harper">Verkauf</option>
                    <option value="Charls Jackson">Verkauf</option>
                    <option value="Wendy Smith">Lager</option>
                    <option value="Anna Harper">Lager</option>
                    <option value="Olivia Mason">Lager</option>
                </datalist>

                <label for="Bewertung">Bewertung</label>
                <select id="Bewertung" name="Bewertung" required>
                    <option value="">Bewertung wählen</option>
                    <option value="Sehr gut">Sehr gut</option>
                    <option value="Gut">Gut</option>
                    <option value="Durchschnitt">Durchschnitt</option>
                    <option value="Schlecht">Schlecht</option>
                </select>

                <label for="Bemerkungen">Bemerkungen</label>
                <textarea id="Bemerkungen" name="Bemerkungen" rows="5" placeholder="Dein Feedback..."></textarea>
            </fieldset>

            <button type="submit">Absenden</button>
        </form>
    </main>

