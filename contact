        </ul>
    </nav>

    <!-- HAUPTINHALT -->
    <main>
        <h2>Kontaktiere uns</h2>
        <p>Hast du Fragen zu unseren Dienstleistungen oder möchtest du eine unverbindliche Beratung? Dann schreibe uns oder rufe uns an!</p>

        <h3>Unsere Kontaktdaten</h3>
        <p><strong>Adresse:</strong> Musterstrasse 77, 4666 Musterstadt</p>
        <p><strong>Telefon:</strong> 076 456 45 45</p>
        <p><strong>E-Mail:</strong> <a href="mailto:info@cinetix.com">info@cinetix.com</a></p>

        <h3>Kontaktformular</h3>
        <form>
            <fieldset>
                <legend>Deine Kontaktdaten</legend>
                <label for="name">Name</label>
                <input type="text" id="name" name="name" placeholder="Dein Name" required>

                <label for="email">E-Mail</label>
                <input type="email" id="email" name="email" placeholder="Deine E-Mail-Adresse" required>

                <label for="betreff">Betreff</label>
                <input type="text" id="betreff" name="betreff" placeholder="Betreff deiner Nachricht" required>
            </fieldset>

            <fieldset>
                <legend>Deine Nachricht</legend>
                <label for="nachricht">Nachricht</label>
                <textarea id="nachricht" name="nachricht" rows="5" placeholder="Schreibe uns eine Nachricht..." required></textarea>
            </fieldset>

            <button type="submit">Nachricht senden</button>
        </form>
    </main>

