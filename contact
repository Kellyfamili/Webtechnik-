    <!-- HEADER -->
    <header>
        <img src="Logo.jpg" alt="Cinetix Media Logo" width="100">
        <h1>Kontakt - Wir sind für dich da!</h1>
    </header>

    <!-- NAVIGATION -->
    <nav>
        <ul>
            <li><a href="index.html">Home</a></li>
